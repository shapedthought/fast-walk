# The build happens inside the image, so nothing built outside it belongs in
# the context. target/ alone runs to hundreds of megabytes once it has been
# used, and sending it costs more than the build.
target/
.git/
.github/

# Results from local runs, which follow these names by default.
results-*.csv
diff-*.csv

# Credentials for a container mount. Nothing here reaches the image, but the
# whole context is sent to the daemon, and a password should not be.
.smbcred
*.cred

Dockerfile
.dockerignore
